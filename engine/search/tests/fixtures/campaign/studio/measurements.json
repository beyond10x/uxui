{
  "format": "ux-search-campaign-measurements/1",
  "adapter": "ux-browser 0.10.0",
  "browser": "HeadlessChrome/159.0.8154.6",
  "declaration": {"digest": "sha256:867e6446b66029d69d0a517e074207cd04ebed38f5bd33e9a1e25ef6bb171606", "text": "# The campaign over the frontier page of the studio app this repository generates from\n# ess/ui/studio.ui.yaml, on its fixtures, with themes/studio.css linked\n# (docs/campaign-2026-11-26-studio-engine.md). Recorded by tools/studio-campaign.sh.\n#\n# Every property an axis sets is one themes/studio.css declares in `:root`; the shipped value of\n# every axis sets nothing, so the page as shipped is the page the theme gives, whatever its\n# values are on the day of a recording.\nformat: ux-search-campaign/1\npage:\n  path: /campaigns/frontier/cp-01\n  # The page has left its loading state: no section shows the loading status any more.\n  ready: 'main.ui-page:not(:has([role=status][aria-label=Loading]))'\n  ready_timeout_ms: 10000\n  # The fixture channel goes from connecting to live after the first paint.\n  settle_ms: 750\nenvironments:\n  # The two gating viewports of the loop round on the studio (ess/ui/rounds/round.sh).\n  viewports: [1366x768, 1280x720]\n  # The theme follows prefers-color-scheme until a person picks a mode with the toggle.\n  modes:\n    - {name: light, media: light}\n    - {name: dark, media: dark}\naxes:\n  # The step between the parts of a page: the gap of the page's stack and the padding of a\n  # section.\n  - name: spacing\n    shipped: space-stock\n    values:\n      - id: space-tight\n        rules:\n          - {selector: ':root', set: {--ui-space-md: 0.8rem}}\n      - id: space-snug\n        rules:\n          - {selector: ':root', set: {--ui-space-md: 0.95rem}}\n      - id: space-stock\n      - id: space-roomy\n        rules:\n          - {selector: ':root', set: {--ui-space-md: 1.3rem}}\n  # The ink of the two status colours the page shows: the live indicator (success) and the\n  # badge of a running campaign (info). In dark mode the theme's inks are kept.\n  - name: status-ink\n    shipped: ink-stock\n    values:\n      - id: ink-stock\n      - id: ink-mid\n        rules:\n          - {selector: ':root', mode: light, set: {--ui-color-success: '#1c7f53', --ui-color-info: '#3467cf'}}\n      - id: ink-deep\n        rules:\n          - {selector: ':root', mode: light, set: {--ui-color-success: '#14633f', --ui-color-info: '#2a55b3'}}\n  # The fill behind those two inks, nearer to the surface it lies on. The theme sets its dark\n  # values under `:root:not([data-uxui-mode=\"light\"])`, so a dark value is set there too.\n  - name: status-fill\n    shipped: fill-stock\n    values:\n      - id: fill-stock\n      - id: fill-pale\n        rules:\n          - {selector: ':root', mode: light, set: {--ui-color-success_fill: '#f2fbf6', --ui-color-info_fill: '#f3f6fe'}}\n          - {selector: ':root:not([data-uxui-mode=\"light\"])', mode: dark, set: {--ui-color-success_fill: '#172a26', --ui-color-info_fill: '#1a2340'}}\n  # The ink of the group headings of the navigation, on the sidebar. In light mode every value\n  # keeps the theme's ink.\n  - name: nav-head\n    shipped: head-stock\n    values:\n      - id: head-stock\n      - id: head-light\n        rules:\n          - {selector: ':root:not([data-uxui-mode=\"light\"])', mode: dark, set: {--uxui-nav-head: '#8b90b3'}}\n# The action the page is for: proposing a variant of the frontier for promotion (the first row's).\nprimary: 'button[data-ui-path$=\"/row_actions/promote\"]'\nregions: '.ui-region-navigation, header.ui-header, section.ui-section'\nalways_visible:\n  - {name: navigation, selector: 'nav.ui-nav'}\n  - {name: view switch, selector: 'nav.ui-switch'}\n# WCAG 2.2 2.5.8, the size the loop round's audit counts small controls by.\nsmall_target_px: 24\nhard: [primary_in_view, no_h_scroll, named]\nterms: [low_contrast, overflow, always_visible_misses, small_targets, primary_px, text_under_14, regions]\n"},
  "environments": ["1366x768 light", "1366x768 dark", "1280x720 light", "1280x720 dark"],
  "columns": ["primary_in_view", "h_scroll", "unnamed", "primary_px", "small_targets", "regions", "text_runs", "text_under_14", "low_contrast", "overflow", "always_visible_misses"],
